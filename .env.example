# CryptoSight v2.0 Configuration
# Copy this file to .env and configure your settings

# Trading Bot Mode (dev/prod)
TRADING_BOT_MODE=prod

# Discord Webhook (for alerts)
DISCORD_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Binance API (if using live trading - optional for signals only)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# Model Settings
MODEL_FILE=BTC_USDT_rf_improved.pkl
FALLBACK_MODEL_FILE=BTC_USDT_rf.pkl

# Signal Generation Settings
DEFAULT_PROBABILITY_THRESHOLD=0.6
MAX_SIGNALS_PER_SCAN=3
DEFAULT_NUM_COINS=50

# Risk Management
MIN_VOLUME_RATIO=0.8
MIN_VOLATILITY_PCT=0.5
MAX_VOLATILITY_PCT=25.0
MIN_MOMENTUM_PCT=1.5

# Monitoring Settings
VERIFICATION_INTERVAL_MINUTES=5
TRADE_TIMEOUT_HOURS=48

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Data Directories
DATA_DIR=data
MODELS_DIR=models
LOGS_DIR=logs

# --- Web app (admin panel + API) ---
# Render provides this automatically once you attach the Postgres
# instance from render.yaml; only set it manually for local dev against
# a real Postgres. Leave unset locally to fall back to SQLite.
# DATABASE_URL=postgresql://user:password@host:5432/cryptosight

# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-before-deploying

# Shared password for the admin panel (single-user auth)
ADMIN_PASSWORD=change-me

# --- AI (OpenRouter) ---
# https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Free models rotate -- check https://openrouter.ai/models before deploying.
# OpenRouter's own auto-router -- picks a currently-free model for you,
# so this survives individual free models being delisted (which happens
# without warning). Override with a specific model ID if you want to
# pin one deliberately -- check https://openrouter.ai/models first.
OPENROUTER_MODEL=openrouter/free
AI_SITE_URL=https://your-app.onrender.com
AI_SITE_NAME=CryptoSight

# AI weight-tuning guardrails
AI_MIN_SAMPLES_FOR_ADJUSTMENT=20
AI_MAX_WEIGHT_STEP_PCT=0.20
AI_MIN_STRATEGY_WEIGHT=0.1
AI_MAX_STRATEGY_WEIGHT=5.0